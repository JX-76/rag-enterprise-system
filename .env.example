# RAG Enterprise System - 环境变量配置示例
# 复制为 .env 文件并填入实际值

# ========== 应用配置 ==========
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ========== LLM配置 ==========
# 选择提供商: openai, anthropic, local
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30.0

# ========== 向量数据库配置 ==========
# 选择提供商: chromadb, milvus, qdrant
VECTOR_PROVIDER=chromadb
VECTOR_COLLECTION_NAME=rag_documents
VECTOR_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_EMBEDDING_DIM=512
VECTOR_DISTANCE_METRIC=cosine

# ChromaDB特定
VECTOR_CHROMA_PERSIST_DIR=./chroma_db

# Milvus特定
VECTOR_MILVUS_HOST=localhost
VECTOR_MILVUS_PORT=19530

# ========== 检索配置 ==========
RETRIEVAL_TOP_K=5
RETRIEVAL_ENABLE_HYBRID=true
RETRIEVAL_DENSE_WEIGHT=0.5
RETRIEVAL_BM25_WEIGHT=0.5
RETRIEVAL_RRF_K=60
RETRIEVAL_ENABLE_RERANK=false

# ========== 分块配置 ==========
CHUNKING_STRATEGY=parent_child
CHUNKING_PARENT_SIZE=1000
CHUNKING_CHILD_SIZE=200
CHUNKING_OVERLAP=40
CHUNKING_RESPECT_SEMANTIC_BOUNDARIES=true

# ========== 熔断器配置 ==========
CIRCUIT_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=30.0
CIRCUIT_HALF_OPEN_MAX_CALLS=3
CIRCUIT_SUCCESS_THRESHOLD=2

# ========== 限流配置 ==========
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# ========== 监控配置 ==========
ENABLE_METRICS=true
METRICS_PORT=9090
